<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- C Shape -->
    <path
        android:pathData="M 85,32 A 40,40 0 1,0 85,88"
        android:strokeWidth="16"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="20"
                android:startY="20"
                android:endX="100"
                android:endY="100"
                android:type="linear">
                <item android:offset="0.0" android:color="#5146E5" />
                <item android:offset="1.0" android:color="#8B5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Graduation Cap on Top-Right -->
    <path
        android:pathData="M 85,15 L 65,26 L 85,37 L 105,26 Z"
        android:fillColor="#5146E5" />
    <path
        android:pathData="M 72,30.5 L 72,40 C 72,43 98,43 98,40 L 98,30.5"
        android:fillColor="#5146E5" />
    <!-- Cap Tassel -->
    <path
        android:pathData="M 100,27 L 104,36"
        android:strokeColor="#8B5CF6"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Sparkle inside C -->
    <path
        android:pathData="M 52,50 C 52,55 47,60 42,60 C 47,60 52,65 52,70 C 52,65 57,60 62,60 C 57,60 52,55 52,50 Z"
        android:fillColor="#8B5CF6" />
</vector>
